# ── Adresses ─────────────────────────────────────────────────────
PORT_BACKEND=8093
BACKEND_URL=http://localhost:8093
PORT_FRONTEND=4211
FRONTEND_URL=http://localhost:4211

# ── Base de données ──────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=devdb
DB_SCHEMA=storage
DB_USER=devuser
DB_PASSWORD=CHANGE_ME

# ── Django ───────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME
DEBUG=False
ALLOWED_HOSTS=*

# ── Reverse proxy (Caddy) ────────────────────────────────────────
SCRIPT_NAME=/storage-api

# ── SSO Keycloak ─────────────────────────────────────────────────
KEYCLOAK_CLIENT_ID=storage
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/ssolab
# Client public (SPA Angular) — Keycloak → Clients → storage → Access type : Public
# Valid redirect URIs : http://localhost:4211/*
# ⚠ Les trois listes ci-dessous ne sont pas des secrets : elles décrivent quelles
# apps du lab sont migrées vers storage. Les laisser vides sur une installation
# neuve ferait perdre silencieusement leur accès (403 à l'upload). Les valeurs
# ci-dessous sont donc celles réellement attendues — à compléter à chaque
# nouvelle app migrée, ici ET dans .env.

# Liste blanche des client_id dont les tokens sont acceptés par l'API (claim
# 'azp'), séparés par des virgules. Défaut : uniquement 'storage' lui-même.
# Ajouter ici le client_id d'une autre app du lab pour l'autoriser à appeler
# cette API au nom de ses utilisateurs (cf. api/authentication.py). Les clients
# des deux listes suivantes sont inclus automatiquement, inutile de les répéter.
KEYCLOAK_TRUSTED_CLIENTS=storage,carto-lab
# Comptes de service (client_credentials, sans utilisateur connecté) : liste
# "client_id:nom-du-partage" séparés par des virgules. Pour une app qui écrit
# sans utilisateur connecté — worker asynchrone, ou lecture anonyme republiée
# par l'app (cas de restauration : carte publique). Le partage doit exister au
# préalable : `manage.py create_group_share <nom> --owner … --required-groups …`.
KEYCLOAK_SERVICE_WRITE_SHARES=restauration-admin:restauration
# Variante préfixe : "client_id:préfixe" séparés par des virgules — le partage
# est créé automatiquement au premier usage (pas de create_group_share requis),
# pour une app qui a besoin de plusieurs partages dynamiques (un par sous-
# ressource, ex. un par bien immobilier).
KEYCLOAK_SERVICE_WRITE_PREFIXES=conciergerie-admin:conciergerie-bien-

# ── Stockage des fichiers ──────────────────────────────────────────
MEDIA_ROOT=/app/media
MAX_UPLOAD_BYTES=209715200

# ── URLs (propagées automatiquement par reset_url.sh) ────────────
PORT_KEYCLOAK=8080
SERVER_URL_LAN=http://192.168.1.X
SERVER_URL_WAN=http://VOTRE_IP_WAN
KEYCLOAK_URL=http://192.168.1.X:8080
KEYCLOAK_PUBLIC_URL=http://VOTRE_IP_WAN:8080

# ── HTTPS / Caddy ─────────────────────────────────────────────────────────────
DOMAIN=CHANGE_ME
